# ── DB (local XAMPP) ─────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tattoo_studio
DB_USER=root
DB_PASS=

# ── App ─────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true

# ── En Railway/producción NO uses estas:
# Railway inyecta automáticamente MYSQLHOST, MYSQLUSER, MYSQLPASSWORD,
# MYSQL_DATABASE, MYSQLPORT (o MYSQL_URL).
# BASE_URL queda en "" (la app vive en la raíz del dominio).
